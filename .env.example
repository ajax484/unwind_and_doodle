# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack Payment Provider Configuration
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Flutterwave Payment Provider Configuration
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Email Configuration (Google / Gmail / Google Workspace)
# NOTE: For Google accounts, enable 2-Step Verification and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Unwind and Doodle <your-account@gmail.com>"

# Sentry Error Monitoring & Runtime Diagnostics
# Leave blank in development/test to run offline; populate in staging & production
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Inngest Background Jobs & Durable Orchestration
# Required only for production & staging cloud sync; local dev runs offline via `npx inngest-cli dev`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Meta (Facebook) Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
META_TEST_EVENT_CODE=



