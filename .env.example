# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack Payment Provider Configuration
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Email Configuration (Google / Gmail / Google Workspace)
# NOTE: For Google accounts, enable 2-Step Verification and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Unwind and Doodle <your-account@gmail.com>"

